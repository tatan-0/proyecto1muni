{
  "name": "sgr-municipalidad-la-serena",
  "version": "1.0.0",
  "private": true,
  "description": "Compilación local de Tailwind CSS y daisyUI para el SGR académico.",
  "scripts": {
    "build:css": "tailwindcss -i ./frontend/input.css -o ./gestion/static/gestion/css/styles.css",
    "watch:css": "tailwindcss -i ./frontend/input.css -o ./gestion/static/gestion/css/styles.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "daisyui": "^5.7.0",
    "tailwindcss": "^4.1.0"
  }
}
